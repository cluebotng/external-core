{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": true,
  "automergeStrategy": "rebase",
  "packageRules": [
    {
      "description": "Group CI updates",
      "matchManagers": ["github-actions"],
      "groupName": "CI dependencies"
    },
    {
      "description": "Group Python updates",
      "matchManagers": ["poetry", "pep621", "pip_requirements", "pyenv"],
      "groupName": "Python dependencies"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update ClueBot NG core release in setup.py",
      "managerFilePatterns": ["/^setup\\.py$/"],
      "matchStrings": ["TARGET_RELEASE = \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "cluebotng/core",
      "datasourceTemplate": "github-releases"
    }
  ]
}
